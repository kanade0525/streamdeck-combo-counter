{
  "SDKVersion": 2,
  "UUID": "com.kanade0525.combocounter",
  "Name": "Combo Counter",
  "Version": "0.1.0.0",
  "Author": "kanade ishida",
  "Description": "PC全体の操作（打鍵・クリック）を数え、途切れずに続いた回数をコンボとして表示します。数えるのは件数だけで、どのキーが押されたかは読み取りません。",
  "Category": "Combo Counter",
  "CategoryIcon": "imgs/category",
  "Icon": "imgs/plugin",
  "URL": "https://github.com/kanade0525/streamdeck-combo-counter",
  "CodePath": "bin/plugin.js",
  "Nodejs": {
    "Version": "20"
  },
  "Software": {
    "MinimumVersion": "6.5"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "UUID": "com.kanade0525.combocounter.combo",
      "Name": "コンボカウンタ",
      "Icon": "imgs/action",
      "Tooltip": "打鍵とクリックを数え、途切れずに続いた回数をコンボとして出す。押すと表示を切替。",
      "Controllers": [
        "Keypad"
      ],
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "imgs/key",
          "TitleAlignment": "middle"
        }
      ]
    }
  ]
}